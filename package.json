{
  "name": "friday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "start": "tsx server/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=4 server/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "mac:build": "bash scripts/build-mac.sh",
    "mac:release": "pnpm check && pnpm apple:check && node scripts/build-mac.mjs --standalone && node scripts/package-mac.mjs",
    "mac:publish": "node scripts/publish-mac.mjs",
    "mac:open": "bash scripts/open-mac.sh",
    "apple:check": "bash scripts/test-apple.sh",
    "apple:composer:check": "bash scripts/test-task-composer.sh",
    "markdown:assets": "node scripts/build-markdown-assets.mjs",
    "browser:assets": "node scripts/build-browser-annotation-assets.mjs",
    "markdown:check": "node scripts/build-markdown-assets.mjs --check && node scripts/test-markdown-assets.mjs && node scripts/test-mermaid-assets.mjs && node scripts/test-markdown-parser.mjs && swift test --package-path apps/apple --filter MarkdownRenderingTests",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status",
    "apple:undo:check": "bash scripts/test-task-undo.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.0.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@cursor/sdk": "1.0.35",
    "@earendil-works/chord": "1.0.2",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-durable": "1.0.2",
    "@hono/node-server": "^1.19.0",
    "@muse-code/sdk": "1.4.6",
    "@opencode-ai/sdk": "1.3.15",
    "@opencode/client": "2.0.28",
    "@opencode/protocol": "2.0.28",
    "@opencode/schema": "2.0.28",
    "diff": "8.0.3",
    "hono": "^4.10.0",
    "jsonc-parser": "3.3.1",
    "node-pty": "1.2.0-beta.15",
    "playwright-core": "1.60.0",
    "typebox": "1.3.27",
    "undici": "^7.30.0",
    "yaml": "2.9.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@pierre/theme": "2.0.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.0.0",
    "@types/yauzl": "3.4.0",
    "dompurify": "3.4.16",
    "esbuild": "0.27.4",
    "fast-text-encoding": "1.0.6",
    "jsdom": "30.1.0",
    "mermaid": "11.17.2",
    "react": "19.2.6",
    "react-grab": "0.1.44",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "unified": "11.0.5"
  }
}
