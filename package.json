{
  "name": "friday",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "tsx watch server/src/main.ts",
    "start": "tsx server/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "mac:build": "bash scripts/build-mac.sh",
    "mac:release": "pnpm check && pnpm apple:check && node scripts/build-mac.mjs --standalone && node scripts/package-mac.mjs",
    "mac:publish": "node scripts/publish-mac.mjs",
    "mac:open": "bash scripts/open-mac.sh",
    "apple:check": "bash scripts/test-apple.sh",
    "service:install": "node scripts/service.mjs install",
    "service:stop": "node scripts/service.mjs uninstall",
    "service:status": "node scripts/service.mjs status"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.292",
    "@earendil-works/pi-durable": "1.0.2",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/chord": "1.0.2",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "typebox": "1.3.27",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
